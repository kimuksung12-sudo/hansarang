// 현재 단계에서는 직원 승인 명단 이외의 모든 Firestore 데이터 접근을 거부합니다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여 넣고 '게시'하세요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 본인 UID의 승인 여부만 조회할 수 있고, 클라이언트 변경은 불가능합니다.
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // 향후 엑셀/어르신 자료는 별도의 권한 설계가 완료되기 전까지 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
