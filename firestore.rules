rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /carePlans/{planId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['personName','recognitionNumber','careGrade','periodStart','periodEnd','needs','needDetails','weeklyCount','weeklyUnit','overallOpinion','createdBy','updatedBy','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['personName','recognitionNumber','careGrade','periodStart','periodEnd','needs','needDetails','weeklyCount','weeklyUnit','overallOpinion','createdBy','updatedBy','createdAt','updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.personName is string
        && request.resource.data.recognitionNumber is string
        && request.resource.data.careGrade is string
        && request.resource.data.periodStart is string
        && request.resource.data.periodEnd is string
        && request.resource.data.needs is list
        && request.resource.data.needs.size() <= 50
        && request.resource.data.needDetails is list
        && request.resource.data.needDetails.size() <= 50
        && (request.resource.data.weeklyCount == null || (request.resource.data.weeklyCount is int && request.resource.data.weeklyCount >= 0 && request.resource.data.weeklyCount <= 99))
        && request.resource.data.weeklyUnit is string
        && request.resource.data.overallOpinion is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personName','recognitionNumber','careGrade','periodStart','periodEnd','needs','needDetails','weeklyCount','weeklyUnit','overallOpinion','updatedBy','updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.personName is string
        && request.resource.data.recognitionNumber is string
        && request.resource.data.needs is list
        && request.resource.data.needDetails is list
        && request.resource.data.needDetails.size() <= 50
        && (request.resource.data.weeklyCount == null || (request.resource.data.weeklyCount is int && request.resource.data.weeklyCount >= 0 && request.resource.data.weeklyCount <= 99));
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
